{
  "name": "frosted-aio",
  "version": "2.0.1",
  "description": "Unofficial control app for TRYX Panorama AIO coolers: pump-screen media, stats overlay, fan curve. Not affiliated with TRYX.",
  "author": "Frosty9999",
  "license": "MIT",
  "repository": "github:Frosty9999/frosted-aio",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron build/make-icon.js",
    "vendor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vendor.ps1",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.frosty9999.frosted-aio",
    "productName": "Frosted-AIO",
    "copyright": "Frosty9999",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/nowplaying.ps1",
      "src/usbio.ps1",
      "src/sensors.ps1"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/sensors",
        "to": "sensors"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Frosted-AIO",
      "artifactName": "Frosted-AIO-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  }
}
